# Secrets — never commit
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Muse Code worktrees (generated, isolated)
.muse/worktrees/

# Build artifacts
# out/ is whatever the last local run emitted: SVD, HALs, the Renode model
# and the compiled firmware. Regenerated by `silicontruth build` and
# `silicontruth emulate`, so committing it only ever creates a stale copy of
# the real output. The committed evidence lives in fixtures/ instead.
out/
*.elf
*.o
*.bin
target/
dist/
build/

# Renode portable install
renode-portable/
*.resc.log

# Datasheets are large; keep them local
# realtest/downloads holds a vendor datasheet and SVD fetched at run time.
# The scripts beside them are committed; the documents are not ours to
# redistribute and are a few MB besides.
realtest/downloads/
realtest/out/
realtest/fixtures/
benchmarks/**/*.pdf
benchmarks/**/*.sr

# Next.js
web/node_modules/
web/.next/
web/out/
web/public/fixtures/
node_modules/

# Scratch for setup-aws.sh policy documents; removed on exit.
.aws-setup/
