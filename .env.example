# Copy to .env and fill in. .env is gitignored — never commit it.

# ---- Meta (required) ----
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# ---- Model IDs (pinned; do not interpolate) ----
SPARK_MODEL=muse-spark-1.3-contributor
SPARK_MODEL_FULL=muse-spark-1.3
SAM_MODEL=sam-3.1
WONDER_MODEL=muse-wonder-1.0
ASR_MODEL=muse-voice-transcribe-1.0
ASR_WS=wss://api.meta.ai/v1/asr/realtime

# ---- Groq (free tier, no card; serves Llama = a Meta open-weight model) ----
# Fallback inference path while the Meta Model API is billing-blocked.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
# Set once the real IDs are confirmed by scripts/smoke_groq.py
GROQ_VISION_MODEL=
GROQ_TEXT_MODEL=

# ---- Infra ----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# ---- Pipeline tuning ----
RENDER_DPI=300
RETRY_DPI=600
MAX_Z3_RETRIES=3
SAM_CONCURRENCY=8
RENODE_TIMEOUT_S=120

# ---- Next.js: client-exposed (NEXT_PUBLIC_ = compiled into the bundle, world-readable) ----
# Never prefix a credential with NEXT_PUBLIC_.
NEXT_PUBLIC_DEFAULT_MODE=replay
NEXT_PUBLIC_FIXTURE_BASE=/fixtures
NEXT_PUBLIC_DEFAULT_CHIP=stm32h7
