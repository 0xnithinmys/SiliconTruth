# Copy to .env and fill in. .env is gitignored — never commit it.

# ---- Meta (required) ----
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Which backend to use. Meta is the primary and intended path.
PROVIDER=meta

# ---- Model IDs (pinned; do not interpolate) ----
SPARK_MODEL=muse-spark-1.3-contributor
SPARK_MODEL_FULL=muse-spark-1.3
# The model that READS a page or crop. This is Spark, not SAM: sam-3.1 is a
# segmentation model served on /v1/responses and returns a 404 on
# /chat/completions. SAM finds where the table is; Spark reads what it says.
VISION_MODEL=muse-spark-1.3-contributor
SAM_MODEL=sam-3.1
WONDER_MODEL=muse-wonder-1.0
ASR_MODEL=muse-voice-transcribe-1.0
ASR_WS=wss://api.meta.ai/v1/asr/realtime

# ---- Groq (optional fallback; unused on the Meta path) ----
# Kept only so a single provider outage is not a single point of failure.
# Leave blank: the project runs on the Meta Model API.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
# Set once the real IDs are confirmed by scripts/smoke_groq.py
GROQ_VISION_MODEL=
GROQ_TEXT_MODEL=

# ---- Infra ----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# ---- Pipeline tuning ----
RENDER_DPI=300
RETRY_DPI=600
MAX_Z3_RETRIES=3
SAM_CONCURRENCY=8
RENODE_TIMEOUT_S=120

# ---- Next.js: client-exposed (NEXT_PUBLIC_ = compiled into the bundle, world-readable) ----
# Never prefix a credential with NEXT_PUBLIC_.
NEXT_PUBLIC_DEFAULT_MODE=replay
NEXT_PUBLIC_FIXTURE_BASE=/fixtures
NEXT_PUBLIC_DEFAULT_CHIP=stm32h7
