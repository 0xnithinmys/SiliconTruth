// uart32 USART1 platform, generated by SiliconTruth
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

mem: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x00100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00020000

usart1: Python.PythonPeripheral @ sysbus 0x40011000
    size: 0x100
    initable: true
    filename: "peripheral_mock.py"
